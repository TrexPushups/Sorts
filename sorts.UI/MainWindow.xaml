<Window x:Class="Sorts.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sorts.UI"
        Title="Sorts.Tests — SortingComplexityTests"
        Height="720" Width="960"
        MinHeight="500" MinWidth="700"
        Background="#09090b"
        FontFamily="Cascadia Code, Fira Code, Consolas, monospace">

    <Window.Resources>

        <!-- Colours -->
        <SolidColorBrush x:Key="BgPrimary"     Color="#09090b"/>
        <SolidColorBrush x:Key="BgSecondary"   Color="#18181b"/>
        <SolidColorBrush x:Key="BgTertiary"    Color="#27272a"/>
        <SolidColorBrush x:Key="Border"        Color="#18181b"/>
        <SolidColorBrush x:Key="BorderMid"     Color="#27272a"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#d4d4d8"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#71717a"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#52525b"/>
        <SolidColorBrush x:Key="TextDimmed"    Color="#3f3f46"/>
        <SolidColorBrush x:Key="Green"         Color="#16a34a"/>
        <SolidColorBrush x:Key="GreenLight"    Color="#22c55e"/>
        <SolidColorBrush x:Key="Red"           Color="#dc2626"/>
        <SolidColorBrush x:Key="RedLight"      Color="#ef4444"/>
        <SolidColorBrush x:Key="Orange"        Color="#f97316"/>

        <!-- Scrollbar style -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="#09090b"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#09090b">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Rectangle Fill="#27272a" RadiusX="2" RadiusY="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="4"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource ThinScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Run button -->
        <Style x:Key="RunButton" TargetType="Button">
            <Setter Property="Background"   Value="#18181b"/>
            <Setter Property="Foreground"   Value="#a1a1aa"/>
            <Setter Property="BorderBrush"  Value="#3f3f46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="14,6"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontFamily"   Value="Cascadia Code, Fira Code, Consolas, monospace"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#71717a"/>
                                <Setter Property="Foreground"  Value="#d4d4d8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"  Value="#52525b"/>
                                <Setter Property="BorderBrush" Value="#27272a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#27272a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter tab button -->
        <Style x:Key="FilterTab" TargetType="ToggleButton">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="#52525b"/>
            <Setter Property="BorderThickness"   Value="0,0,0,2"/>
            <Setter Property="BorderBrush"       Value="Transparent"/>
            <Setter Property="Padding"           Value="14,8"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontFamily"        Value="Cascadia Code, Fira Code, Consolas, monospace"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground"  Value="#d4d4d8"/>
                                <Setter Property="BorderBrush" Value="#71717a"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#a1a1aa"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Group header -->
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground"       Value="#52525b"/>
            <Setter Property="FontSize"         Value="10"/>
            <Setter Property="Padding"          Value="16,6"/>
            <Setter Property="Background"       Value="#09090b"/>

        </Style>

        <!-- Expand button -->
        <Style x:Key="ExpandBtn" TargetType="ToggleButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="4">
                            <Path x:Name="Arrow"
                                  Data="M0,0 L5,5 L10,0"
                                  Stroke="#52525b" StrokeThickness="1.2"
                                  StrokeLineJoin="Round" Fill="Transparent"
                                  Width="10" Height="6"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="ArrowRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="180" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataTemplates for test result rows -->
        <DataTemplate x:Key="TestRowTemplate" DataType="{x:Type local:TestResultVm}">
            <Border BorderBrush="#1c1c1e" BorderThickness="0,0,0,1"
                    Background="Transparent">
                <StackPanel>
                    <!-- Header row -->
                    <Border x:Name="RowBg" Background="Transparent" Padding="16,9,16,9">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding ToggleDetailCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>

                            <!-- Status icon -->
                            <local:StatusIcon Grid.Column="0"
                                              Status="{Binding Status}"
                                              Width="14" Height="14"
                                              VerticalAlignment="Center"/>

                            <!-- Test name -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       Foreground="{Binding NameColor}"
                                       FontSize="12.5"
                                       Margin="10,0,10,0"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>

                            <!-- Duration -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DurationText}"
                                       Foreground="#52525b"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>

                            <!-- Chevron (only for failures with detail) -->
                            <ToggleButton Grid.Column="3"
                                          Style="{StaticResource ExpandBtn}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                          Visibility="{Binding ChevronVisibility}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Detail panel (failures only) -->
                    <Border Visibility="{Binding DetailVisibility}"
                            Margin="38,0,16,12"
                            Background="#0f0f0f"
                            BorderBrush="#27272a" BorderThickness="1"
                            CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <!-- Mismatch label -->
                            <TextBlock Text="{Binding DetailHeader}"
                                       Foreground="#ef4444"
                                       FontSize="11"
                                       Margin="0,0,0,10"/>

                            <!-- Declared row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Declared" Foreground="#71717a" FontSize="11" Grid.Column="0"/>
                                <local:R2Bar Grid.Column="1" Value="{Binding DeclaredR2}" BarColor="#ef4444" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding DeclaredLabel}"
                                           Foreground="#ef4444" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Best fit row -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Best fit" Foreground="#71717a" FontSize="11" Grid.Column="0"/>
                                <local:R2Bar Grid.Column="1" Value="{Binding BestR2}" BarColor="#22c55e" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding BestLabel}"
                                           Foreground="#22c55e" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Gap row -->
                            <Border BorderBrush="#27272a" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Gap" Foreground="#71717a" FontSize="11" Grid.Column="0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GapLabel}"
                                               Foreground="#f97316" FontSize="11" FontWeight="Medium"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#111113"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Summary metrics -->
            <RowDefinition Height="2"/>      <!-- Progress bar -->
            <RowDefinition Height="Auto"/>   <!-- Filter tabs -->
            <RowDefinition Height="*"/>      <!-- Results list -->
            <RowDefinition Height="Auto"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" BorderBrush="#18181b" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icon -->
                    <Border Width="28" Height="28" CornerRadius="6"
                            Background="#18181b" BorderBrush="#27272a" BorderThickness="1"
                            Margin="0,0,10,0">
                        <Path Data="M6,14 L11,4 L16,14 Z"
                              Stroke="#71717a" StrokeThickness="1.2"
                              StrokeLineJoin="Round" Fill="Transparent"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Width="10" Height="10"/>
                    </Border>
                    <TextBlock Text="Sorts.Tests" Foreground="#71717a" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text=" / " Foreground="#27272a" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="SortingComplexityTests" Foreground="#a1a1aa" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WallTimeText}"
                               Foreground="#3f3f46" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource RunButton}"
                            Command="{Binding RunCommand}"
                            IsEnabled="{Binding CanRun}"
                            Content="{Binding RunButtonText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Summary metrics ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#18181b" BorderThickness="0,0,1,1" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="TESTS" Foreground="#3f3f46" FontSize="10" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TotalCount}" Foreground="#71717a" FontSize="22" FontWeight="Medium"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" BorderBrush="#18181b" BorderThickness="0,0,1,1" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="PASSED" Foreground="#3f3f46" FontSize="10" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding PassedCount}" Foreground="#16a34a" FontSize="22" FontWeight="Medium"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="#18181b" BorderThickness="0,0,1,1" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="FAILED" Foreground="#3f3f46" FontSize="10" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding FailedCount}" Foreground="{Binding FailedColor}" FontSize="22" FontWeight="Medium"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" BorderBrush="#18181b" BorderThickness="0,0,0,1" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="DURATION" Foreground="#3f3f46" FontSize="10" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DurationText}" Foreground="#71717a" FontSize="22" FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Progress bar ── -->
        <Grid Grid.Row="2" Background="#18181b">
            <Rectangle x:Name="ProgressFill"
                       HorizontalAlignment="Left"
                       Width="{Binding ProgressWidth}"
                       Fill="{Binding ProgressColor}">
                <Rectangle.RenderTransform>
                    <TranslateTransform/>
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <!-- ── Filter tabs ── -->
        <Border Grid.Row="3" BorderBrush="#18181b" BorderThickness="0,0,0,1" Padding="12,0">
            <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource FilterTab}"
                              Content="{Binding AllTabText}"
                              IsChecked="{Binding FilterAll, Mode=TwoWay}"
                              Command="{Binding FilterCommand}"
                              CommandParameter="all"/>
                <ToggleButton Style="{StaticResource FilterTab}"
                              Content="{Binding PassedTabText}"
                              IsChecked="{Binding FilterPassed, Mode=TwoWay}"
                              Command="{Binding FilterCommand}"
                              CommandParameter="passed"/>
                <ToggleButton Style="{StaticResource FilterTab}"
                              Content="{Binding FailedTabText}"
                              IsChecked="{Binding FilterFailed, Mode=TwoWay}"
                              Command="{Binding FilterCommand}"
                              CommandParameter="failed"/>
            </StackPanel>
        </Border>

        <!-- ── Results list ── -->
        <ScrollViewer Grid.Row="4"
                      Style="{StaticResource ThinScrollViewer}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding GroupedResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:GroupVm}">
                        <StackPanel>
                            <!-- Group header -->
                            <Border BorderBrush="#1c1c1e" BorderThickness="0,0,0,1"
                                    Padding="16,6" Background="#09090b">
                                <Grid>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#52525b" FontSize="10"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Summary}"
                                               Foreground="#3f3f46" FontSize="10"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- Test rows -->
                            <ItemsControl ItemsSource="{Binding Tests}"
                                          ItemTemplate="{StaticResource TestRowTemplate}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Footer ── -->
        <Border Grid.Row="5"
                BorderBrush="#18181b" BorderThickness="0,1,0,0"
                Padding="20,10"
                Visibility="{Binding FooterVisibility}">
            <Grid>
                <TextBlock Text="{Binding FooterStatus}"
                           Foreground="{Binding FooterColor}"
                           FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FooterRight}"
                           Foreground="#3f3f46" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
